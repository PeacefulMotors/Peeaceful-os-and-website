{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peeaceful-os-and-website",
  "compatibility_date": "2026-04-01",
  "main": "./worker.js",
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "peaceful-os-community-media"
    }
  ]
}
