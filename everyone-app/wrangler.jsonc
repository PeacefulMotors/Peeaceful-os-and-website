{
  "name": "peaceful-os-app-router",
  "main": "./worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-28",
  "routes": [
    {
      "pattern": "academy.peacefulmotors.com/*",
      "zone_name": "peacefulmotors.com"
    },
    {
      "pattern": "inspect.peacefulmotors.com",
      "zone_name": "peacefulmotors.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "owner.peacefulmotors.com",
      "zone_name": "peacefulmotors.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "tech.peacefulmotors.com",
      "zone_name": "peacefulmotors.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "customer.peacefulmotors.com",
      "zone_name": "peacefulmotors.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "schedule.peacefulmotors.com",
      "zone_name": "peacefulmotors.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ]
}